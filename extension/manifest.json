{
  "manifest_version": 3,
  "name": "QTS_Startup",
  "version": "1.42.4",
  "description": "Capture job postings with QTS_Startup.",
  "permissions": ["activeTab", "storage", "tabs", "scripting", "webNavigation", "alarms", "downloads", "notifications", "debugger"],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared/page-exclusions.js",
        "shared/text-highlighting.js",
        "content/text-highlighter.js",
        "content/page-toast.js",
        "content/page-launcher.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/qts-site-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/wys-launcher.png",
        "assets/account-logo.png",
        "signin/signin.html"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "QTS_Startup",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
