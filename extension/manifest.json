{
  "manifest_version": 3,
  "name": "QTS_Startup",
  "version": "1.60.2",
  "description": "Capture job postings with QTS_Startup.",
  "permissions": ["activeTab", "storage", "tabs", "scripting", "webNavigation", "alarms", "downloads", "notifications", "debugger", "browsingData"],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared/page-exclusions.js",
        "shared/text-highlighting.js",
        "shared/get-jd-notifications.js",
        "content/text-highlighter.js",
        "content/page-toast.js",
        "content/page-launcher.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/qts-site-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/account-logo.png",
        "signin/signin.html",
        "settings/apply-pdf-folder-panel.html",
        "settings/apply-pdf-folder-panel.js",
        "shared/scanner-document-store.js",
        "shared/apply-local-pdfs.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "QTS_Startup",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "Show or hide the QTS panel"
    },
    "toggle-get-jd": {
      "suggested_key": {
        "default": "Alt+G"
      },
      "description": "Turn Get JD on or off"
    },
    "toggle-text-highlights": {
      "suggested_key": {
        "default": "Alt+H"
      },
      "description": "Show or hide the Highlight panel"
    },
    "auto-apply-ask-ai": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "Auto Apply: Ask AI on this job page (the empty boxes of the step)"
    },
    "focus-auto-apply": {
      "description": "Auto Apply: bring the application’s tab to the front with its panel (no key unless you set one)"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
