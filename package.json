{
  "name": "qts-job-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:extension": "node scripts/build-extension.cjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "npm run test:server && npm run test:extension",
    "test:server": "node scripts/run-tsx-tests.cjs",
    "test:extension": "node --test extension/shared/*.test.js extension/content/*.test.js extension/content/extractors/*.test.js extension/popup/*.test.js",
    "db:generate": "node --require ./scripts/node-user-shim.cjs ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --require ./scripts/node-user-shim.cjs ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:seed:super-admin": "tsx scripts/seed-super-admin.ts",
    "db:seed:prompts": "tsx scripts/seed-prompts.ts",
    "db:backfill:job-relations": "tsx scripts/backfill-job-relations.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@sparticuz/chromium": "153.0.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.12",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "pdf-lib": "^1.17.1",
    "puppeteer-core": "25.11.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@fontsource/archivo-black": "5.3.0",
    "@fontsource/arimo": "5.3.0",
    "@fontsource/caladea": "5.3.0",
    "@fontsource/carlito": "5.3.0",
    "@fontsource/dejavu-sans": "5.3.0",
    "@fontsource/fira-sans": "5.3.0",
    "@fontsource/gelasio": "5.3.0",
    "@fontsource/inconsolata": "5.3.0",
    "@fontsource/tinos": "5.3.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
