DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
AUTH_SECRET=generate-a-unique-random-secret-at-least-32-characters
OPENAI_API_KEY=
# Optional comma-separated keys; QTS caps each at 9 calls/60s, 200/day,
# and 25,000 input tokens/60s. Daily usage resets at midnight Pacific.
GEMINI_API_KEYS=
# Used when GEMINI_API_KEYS is empty.
GEMINI_API_KEY=
# Legacy Get JD key name is also supported: JD_READ_PROMPT_GEMINI_API_KEY_1
SUPER_ADMIN_DISPLAY_NAME=
SUPER_ADMIN_LOGIN_NAME=
SUPER_ADMIN_PASSWORD=
# Local development only: Chrome or Edge used to print Generation PDFs from the
# HTML templates (Vercel uses its bundled Chromium). Example for Windows:
# PDF_CHROME_EXECUTABLE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
PDF_CHROME_EXECUTABLE_PATH=
